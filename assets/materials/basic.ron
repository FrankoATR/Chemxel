// Base materials. Schema: crates/mv_materials/README.md
// Temperatures in °C, density in kg/m³, colours as sRGB (r, g, b, alpha).
// latent_heat: energy per voxel relative to the lowest phase (or, for fuels, released
// by burning), in density × heat_capacity units (game-tuned, see the README).
// "air" is required and always gets MaterialId 0. `category` is the inventory tab.
[
    Material(name: "air",      state: Gas,    density: 1.2,  color: (0, 0, 0, 0),         conductivity: 0.02,
             heat_loss: 0.01),

    // --- Terrain ---
    Material(name: "stone",    category: "Terrain", state: Solid,  density: 2600, color: (120, 120, 125, 255), conductivity: 2.5,
             heat_capacity: 0.8, melt_at: 1200, melts_into: "lava"),
    Material(name: "dirt",     category: "Terrain", state: Solid,  density: 1500, color: (115, 80, 50, 255),   conductivity: 0.5,
             heat_capacity: 0.8),
    Material(name: "grass",    category: "Terrain", state: Solid,  density: 1300, color: (82, 132, 56, 255),   conductivity: 0.4,
             latent_heat: 100000,
             flammable: true, ignite_at: 250, burns_into: "dirt", burn_rate: 0.05),
    Material(name: "sand",     category: "Terrain", state: Powder, density: 1600, color: (220, 200, 140, 255), conductivity: 0.3,
             heat_capacity: 0.8, melt_at: 1700, melts_into: "glass"),

    // --- Water cycle ---
    Material(name: "water",    category: "Liquids", state: Liquid, density: 1000, color: (40, 90, 200, 180),   conductivity: 0.6,
             heat_capacity: 4.18, dispersion: 5, latent_heat: 300000,
             boil_at: 100, boils_into: "steam", freeze_at: 0, freezes_into: "ice",
             evaporates_into: "vapor", evaporate_rate: 0.02),
    Material(name: "ice",      category: "Building", state: Solid,  density: 917,  color: (190, 220, 255, 220), conductivity: 2.2,
             heat_capacity: 2.1, base_temperature: -10, melt_at: 0, melts_into: "water"),
    Material(name: "steam",    category: "Gases", state: Gas,    density: 0.6,  color: (220, 220, 230, 90),  conductivity: 0.02,
             heat_capacity: 2.0, latent_heat: 360000, lifetime: (200, 600),
             freeze_at: 99, freezes_into: "water"),

    // --- Heat ---
    // Lava cools and solidifies slowly: a lot of thermal mass (heat_capacity and
    // latent_heat x3), it stays molten down to 300 °C, it solidifies at a slow rate
    // once below that, and loose surface voxels crust over slowly. A 1 m x 25 cm
    // pool on stone takes about 90 s to solidify completely.
    Material(name: "lava",     category: "Liquids", state: Liquid, density: 3100, color: (255, 90, 20, 255),   conductivity: 0.8,
             transition_rate: 0.004,
             heat_capacity: 3.0, emissive: 4.0, dispersion: 1, base_temperature: 1300,
             latent_heat: 3000000,
             freeze_at: 300, freezes_into: "stone",
             evaporates_into: "basalt", evaporate_rate: 0.004),
    Material(name: "obsidian", category: "Building", state: Solid,  density: 2400, color: (30, 20, 45, 255),    conductivity: 1.3,
             melt_at: 1300, melts_into: "lava"),
    Material(name: "glass",    category: "Building", state: Solid,  density: 2500, color: (200, 230, 235, 120), conductivity: 1.0,
             melt_at: 1500, melts_into: "lava"),

    // --- Combustion ---
    // A flammable voxel burns while its cell is above `ignite_at`: each tick it may be
    // consumed (`burn_rate`, releasing `latent_heat`) or emit a `flame` into the air.
    Material(name: "wood",     category: "Nature", state: Solid,  density: 700,  color: (130, 85, 45, 255),   conductivity: 0.15,
             heat_capacity: 1.7, latent_heat: 1000000,
             flammable: true, ignite_at: 280, burns_into: "ash", burn_rate: 0.02,
             flame: "fire", flame_rate: 0.12),
    Material(name: "leaves",   category: "Nature", state: Solid,  density: 400,  color: (60, 125, 45, 255),   conductivity: 0.1,
             heat_capacity: 1.5, latent_heat: 400000,
             flammable: true, ignite_at: 220, burns_into: "ash", burn_rate: 0.06,
             flame: "fire", flame_rate: 0.25),
    Material(name: "fire",     category: "Energy", state: Energy, density: 0.3,  color: (255, 160, 40, 230),  conductivity: 0.05,
             emissive: 6.0, base_temperature: 800, lifetime: (10, 30), decays_into: "smoke"),
    Material(name: "smoke",    category: "Gases", state: Gas,    density: 0.9,  color: (105, 105, 110, 120), conductivity: 0.02,
             heat_loss: 0.01, lifetime: (20, 80)),
    Material(name: "ash",      category: "Nature", state: Powder, density: 600,  color: (90, 88, 85, 255),    conductivity: 0.1),

    // --- Chemistry ---
    Material(name: "acid",     category: "Liquids", state: Liquid, density: 1200, color: (140, 230, 40, 200),  conductivity: 0.5,
             heat_capacity: 3.5, dispersion: 4,
             evaporates_into: "air", evaporate_rate: 0.01),

    // --- Weather (appended: existing ids must not change) ---
    // Cold water vapour from evaporating puddles. It rises for a moment above the
    // puddle and, when its short life ends, condenses into the cloud layer at its
    // `ceiling` height above (or turns into cloud on the spot if it gets that high).
    // Clouds are still and fade after a couple of minutes (no rain yet); they are
    // lighter than vapour so it cannot rise through them.
    Material(name: "vapor",    category: "Gases", state: Gas,    density: 0.8,  color: (225, 230, 236, 70),  conductivity: 0.02,
             dispersion: 2, spreads: false, lifetime: (15, 45), ceiling: 480, ceiling_into: "cloud"),
    Material(name: "cloud",    category: "Gases", state: Gas,    density: 0.4,  color: (245, 247, 250, 150), conductivity: 0.02,
             drifts: false, lifetime: (3000, 9000)),
    // Crust of loose lava that cooled at the surface.
    Material(name: "basalt",   category: "Terrain", state: Solid, density: 2900, color: (58, 54, 58, 255),   conductivity: 2.0,
             heat_capacity: 0.85, melt_at: 1200, melts_into: "lava"),

    // --- Landscape (appended: existing ids must not change) ---
    // Vegetation the terrain generator scatters on meadows: the player walks through
    // it (`passable`), and it burns like grass.
    Material(name: "tall_grass",    category: "Nature", state: Solid, density: 300, color: (96, 152, 60, 255),  conductivity: 0.1,
             latent_heat: 80000, passable: true,
             flammable: true, ignite_at: 220, burns_into: "air", burn_rate: 0.08),
    Material(name: "flower_red",    category: "Nature", state: Solid, density: 300, color: (212, 46, 64, 255),  conductivity: 0.1,
             latent_heat: 80000, passable: true,
             flammable: true, ignite_at: 220, burns_into: "air", burn_rate: 0.08),
    Material(name: "flower_yellow", category: "Nature", state: Solid, density: 300, color: (244, 204, 56, 255), conductivity: 0.1,
             latent_heat: 80000, passable: true,
             flammable: true, ignite_at: 220, burns_into: "air", burn_rate: 0.08),
    Material(name: "flower_violet", category: "Nature", state: Solid, density: 300, color: (168, 112, 226, 255), conductivity: 0.1,
             latent_heat: 80000, passable: true,
             flammable: true, ignite_at: 220, burns_into: "air", burn_rate: 0.08),
    // Autumn foliage of the generated trees.
    Material(name: "leaves_autumn", category: "Nature", state: Solid, density: 400, color: (214, 84, 30, 255),  conductivity: 0.1,
             heat_capacity: 1.5, latent_heat: 400000,
             flammable: true, ignite_at: 220, burns_into: "ash", burn_rate: 0.06,
             flame: "fire", flame_rate: 0.25),
    Material(name: "leaves_gold",   category: "Nature", state: Solid, density: 400, color: (226, 168, 40, 255), conductivity: 0.1,
             heat_capacity: 1.5, latent_heat: 400000,
             flammable: true, ignite_at: 220, burns_into: "ash", burn_rate: 0.06,
             flame: "fire", flame_rate: 0.25),
    // Brown rock of the strata on cliffs.
    Material(name: "sandstone",     category: "Terrain", state: Solid, density: 2300, color: (172, 118, 78, 255), conductivity: 1.7,
             heat_capacity: 0.8, melt_at: 1300, melts_into: "lava"),
]
