// Chemxel runtime configuration.
// Every field is optional; missing fields use the defaults from `mv_core::config`.
// Distances and heights are in microvoxels (16 per metre) unless the name says otherwise.
(
    window: (
        title: "Chemxel",
        width: 1600,
        height: 900,
    ),
    sim: (
        tick_rate_hz: 30.0,
        max_ticks_per_frame: 4,
        seed: 12648430,
        sleep_after_ticks: 2,    // ticks without changes before a chunk sleeps
        ambient_temperature: 20.0,
        diffusion_rate: 300.0,  // heat diffusion speed
        transition_rate: 0.1,    // probability per tick of a phase change past its threshold
        transition_hysteresis: 2.0,
        thermal_epsilon: 0.5,    // °C from ambient where temperature fields sleep/grow
        // Structural integrity: bigger (or wider) connected solids count as anchored.
        integrity_max_voxels: 65536,
        integrity_max_extent: 192,
        integrity_budget_voxels: 262144,  // flood fill voxels per tick
        integrity_min_voxels: 64,         // smaller floating pieces stay in place
        integrity_natural_period: 8,      // ticks between checks of burnt/melted/eaten solids
    ),
    render: (
        vsync: true,
        render_distance_chunks: 16,  // horizontal radius (1 chunk = 4 m)
        render_height_chunks: 8,     // vertical radius around the camera (covers mountains)
        // 8³ bricks, 1 KiB each: 262144 = 256 MiB of GPU memory.
        brick_pool_capacity: 262144,
        chunk_slot_capacity: 8192,   // 2 KiB each
        upload_budget_kib: 8192,     // streamed data per frame; edits are never delayed
        heat_view_capacity: 1024,    // temperature fields shown by F5 (16 KiB each)
        fov_y_deg: 70.0,
    ),
    world: (
        sea_level: 0,
        terrain: (
            base_height: 24.0,
            hills_amplitude: 96.0,
            hills_wavelength: 1400.0,
            detail_amplitude: 10.0,
            detail_wavelength: 160.0,
            mountain_amplitude: 320.0,
            mountain_wavelength: 2200.0,
            octaves: 5,
            dirt_depth: 24,
            grass_depth: 2,
            beach_height: 6,
        ),
        unload_margin_chunks: 2,
        max_inflight_jobs: 64,
        anchor_depth: 32,        // solids this far below the generated surface never fall
    ),
    controls: (
        fly_speed: 4.0,          // m/s
        fast_multiplier: 5.0,    // while holding Shift
        mouse_sensitivity: 0.0025,
    ),
    editor: (
        brush_radius: 6.0,
        max_brush_radius: 48.0,
        reach: 1024.0,
        repeat_hz: 12.0,
    ),
    physics: (
        gravity: 9.81,           // m/s²
        settle_speed: 0.05,      // m/s (and rad/s): slower than this for settle_ticks
        settle_ticks: 15,        // ... puts a body back into the voxel grid
        max_body_seconds: 20.0,
        world_margin: 12,        // world voxels around a body that get a collider
        max_bodies: 64,
        max_body_voxels: 4194304,  // GPU storage for body voxels (2 bytes each)
        friction: 0.7,
        restitution: 0.05,
        max_substeps: 16,        // per tick; bodies move <= half a voxel per substep
    ),
)
