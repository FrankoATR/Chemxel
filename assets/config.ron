// Chemxel runtime configuration.
// Every field is optional; missing fields use the defaults from `mv_core::config`.
(
    window: (
        title: "Chemxel",
        width: 1600,
        height: 900,
    ),
    sim: (
        tick_rate_hz: 30.0,
        max_ticks_per_frame: 4,
        seed: 12648430,
    ),
    render: (
        vsync: true,
        render_distance_chunks: 16,
        // 8³ bricks, 1 KiB each: 65536 = 64 MiB of GPU memory.
        brick_pool_capacity: 65536,
        fov_y_deg: 70.0,
    ),
    controls: (
        fly_speed: 4.0,          // m/s (1 m = 16 microvoxels)
        fast_multiplier: 5.0,    // while holding Shift
        mouse_sensitivity: 0.0025,
    ),
)
