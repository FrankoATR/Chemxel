// Chemxel runtime configuration.
// Every field is optional; missing fields use the defaults from `mv_core::config`.
// Distances and heights are in microvoxels (16 per metre) unless the name says otherwise.
(
    window: (
        title: "Chemxel",
        width: 1600,
        height: 900,
    ),
    sim: (
        tick_rate_hz: 30.0,
        max_ticks_per_frame: 4,
        seed: 12648430,
    ),
    render: (
        vsync: true,
        render_distance_chunks: 16,  // horizontal radius (1 chunk = 4 m)
        render_height_chunks: 8,     // vertical radius around the camera (covers mountains)
        // 8³ bricks, 1 KiB each: 262144 = 256 MiB of GPU memory.
        brick_pool_capacity: 262144,
        chunk_slot_capacity: 8192,   // 2 KiB each
        upload_budget_kib: 8192,     // streamed data per frame; edits are never delayed
        fov_y_deg: 70.0,
    ),
    world: (
        sea_level: 0,
        terrain: (
            base_height: 24.0,
            hills_amplitude: 96.0,
            hills_wavelength: 1400.0,
            detail_amplitude: 10.0,
            detail_wavelength: 160.0,
            mountain_amplitude: 320.0,
            mountain_wavelength: 2200.0,
            octaves: 5,
            dirt_depth: 24,
            grass_depth: 2,
            beach_height: 6,
        ),
        unload_margin_chunks: 2,
        max_inflight_jobs: 64,
    ),
    controls: (
        fly_speed: 4.0,          // m/s
        fast_multiplier: 5.0,    // while holding Shift
        mouse_sensitivity: 0.0025,
    ),
    editor: (
        brush_radius: 6.0,
        max_brush_radius: 48.0,
        reach: 1024.0,
        repeat_hz: 12.0,
    ),
)
